<html>
    <head>
        <title><%= title %></title>
    </head>
    <body>
        <h1>Mini Message Board</h1>
        <ul>
            <% for (let i = 0; i < messages.length; i++) { %>
                <li>
                    <p><%= messages[i].message %></p>
                    <p><%= messages[i].username %></p>
                    <p><%= messages[i].date %></p>
                    <a href="/message/<%= messages[i].id %>">Open</a>
                </li>
            <% } %>
        </ul>
        <a href="/new">Post a message</a>
    </body>
</html>